# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
# Workspace packages (frontend/, web/, services/*) each get their own
# node_modules in this monorepo — the root-only pattern below used to miss
# them (real gap found before the first real push: frontend/node_modules
# and two services/*/node_modules were about to be committed, 350MB+).
node_modules/
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js — same nested-workspace gap as node_modules above: frontend/.next
# and web/.next (2GB+ combined) were not being ignored by the root-only
# pattern.
.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

/src/generated/prisma

# local file storage (dev-only stand-in for S3)
/.data
/infra/k8s/base/secret.yaml
/infra/logs/

# python
__pycache__/
*.pyc
.venv/
venv/
.pytest_cache/
*.test_session_backup

# local agent tooling state
/.claude/
