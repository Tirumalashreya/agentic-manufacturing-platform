{
  "name": "aps-platform",
  "version": "0.1.0",
  "private": true,
  "workspaces": [
    "web",
    "frontend",
    "packages/*",
    "services/*"
  ],
  "scripts": {
    "db:migrate": "npm run -w @aps/domain prisma:migrate",
    "db:generate": "npm run -w @aps/domain prisma:generate",
    "check:architecture": "node architecture/check-contract.mjs",
    "test:architecture": "node --test architecture/check-contract.test.mjs"
  },
  "devDependencies": {
    "concurrently": "^9.1.0",
    "typescript": "^5",
    "js-yaml": "^4.1.0"
  }
}
