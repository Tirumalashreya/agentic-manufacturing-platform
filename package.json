{
  "name": "aps-platform",
  "version": "0.1.0",
  "private": true,
  "workspaces": [
    "web",
    "frontend",
    "packages/*",
    "services/*"
  ],
  "scripts": {
    "start:platform": "./scripts/start-platform.sh",
    "dev:commercial": "npm run -w frontend dev",
    "dev:aps": "npm run -w @aps/web dev",
    "dev:all-ui": "concurrently \"npm run dev:commercial\" \"npm run dev:aps\"",
    "db:migrate": "npm run -w @aps/domain prisma:migrate",
    "db:generate": "npm run -w @aps/domain prisma:generate",
    "check:architecture": "node architecture/check-contract.mjs",
    "test:architecture": "node --test architecture/check-contract.test.mjs"
  },
  "devDependencies": {
    "concurrently": "^9.1.0",
    "typescript": "^5",
    "js-yaml": "^4.1.0"
  }
}
